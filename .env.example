# PostgreSQL
POSTGRES_USER=fluid_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fluid_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend
APP_DEBUG=false
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://fluid_user:change-me@localhost:5432/fluid_db
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
JWT_SECRET_KEY=change-me-super-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
SECURITY_HEADERS_ENABLED=true
MAX_AUTH_HEADER_LENGTH=4096

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Hospital verification and email (never commit real credentials)
FRONTEND_URL=http://localhost:3000
VERIFICATION_UPLOAD_DIR=backend/private_uploads/hospital_verifications
VERIFICATION_MAX_FILE_BYTES=10485760
ADMIN_VERIFICATION_EMAIL=verification@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
